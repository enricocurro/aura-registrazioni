# ── Obbligatorie ─────────────────────────────────────────────────────────────
# Due accessi: "user" può solo registrare, "admin" può anche ascoltare e valutare.
USER_USERNAME=user
USER_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Stringa casuale lunga (es. `openssl rand -hex 32`). Senza, le sessioni si azzerano a ogni riavvio.
SESSION_SECRET=

# ── Facoltative ──────────────────────────────────────────────────────────────
PORT=3000
# Cartella dove finiscono audio e valutazioni. In produzione deve stare su un disco persistente.
DATA_DIR=./data
# Durata massima di una registrazione, in minuti.
MAX_MINUTES=30
# Mettere 1 se il servizio sta dietro un proxy/HTTPS gestito dall'hosting (Render, Railway, Fly, nginx…).
TRUST_PROXY=0
# Mettere 1 in produzione: il cookie di sessione viaggia solo su HTTPS.
COOKIE_SECURE=0

# Trascrizione automatica (Google Cloud Speech-to-Text v2): stesse variabili del backend Aura.
# Senza, le battute restano senza testo e chi valuta lo scrive a mano.
GOOGLE_STT_CREDENTIALS_JSON=
# In alternativa: percorso del file JSON della chiave del service account (relativo alla cartella dell'app).
GOOGLE_STT_CREDENTIALS_FILE=
GOOGLE_STT_LOCATION=eu

# Conversazioni da recitare generate ogni volta (OpenRouter). Senza, si usa la raccolta in copioni.json.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1

# Analisi delle battute coi prompt di Aura (cascata aggressivo → assertivo): usa la stessa OPENROUTER_API_KEY.
# Senza chiave le battute restano senza esito. Il modello è quello di Aura: cambiarlo solo per prove.
ANALYSIS_MODEL=openai/gpt-4.1
